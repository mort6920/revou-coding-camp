<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Life Dashboard</title>
  <link rel="stylesheet" href="css/style.css" />
</head>

<body>

  <!-- Tombol ganti tema — pojok kanan atas -->
  <div class="theme-bar">
    <span class="theme-label">Theme:</span>
    <button class="theme-btn" data-theme="light"    aria-label="Light mode">☀️ Light</button>
    <button class="theme-btn" data-theme="original" aria-label="Original mode">🌆 Original</button>
    <button class="theme-btn" data-theme="dark"     aria-label="Dark mode">🌙 Dark</button>
  </div>

  <!-- Seluruh konten dashboard dibungkus dalam main -->
  <main class="dashboard">

    <!-- ==============================
         SECTION 1: Greeting & Clock
    ================================= -->
    <header class="card greeting-card">
      <p id="current-time" class="clock">00:00:00</p>
      <p id="current-date" class="date">Monday, January 1, 2026</p>
      <h1 id="greeting-text" class="greeting">Good Morning</h1>
    </header>

    <!-- ==============================
         SECTION 2 & 3: Timer + Tasks
         (side by side layout)
    ================================= -->
    <div class="row">

      <!-- Focus Timer -->
      <section class="card timer-card" aria-label="Focus Timer">
        <h2 class="section-title">Focus Timer</h2>
        <p id="timer-display" class="timer-display">25:00</p>

        <div class="timer-controls">
          <button id="btn-start" type="button">Start</button>
          <button id="btn-stop"  type="button">Stop</button>
          <button id="btn-reset" type="button">Reset</button>
        </div>

        <!-- Challenge: Change Pomodoro time -->
        <div class="timer-custom">
          <label for="custom-minutes">Set duration (minutes):</label>
          <input
            id="custom-minutes"
            type="number"
            min="1"
            max="60"
            value="25"
          />
          <button id="btn-set-timer" type="button">Set</button>
        </div>
      </section>

      <!-- Tasks -->
      <section class="card tasks-card" aria-label="Tasks">
        <h2 class="section-title">Tasks</h2>

        <!-- Form tambah task -->
        <form id="task-form" class="task-form">
          <input
            id="task-input"
            type="text"
            placeholder="Add a new task..."
            autocomplete="off"
          />
          <button type="submit">Add</button>
        </form>

        <!-- Challenge: Sort tasks -->
        <div class="task-sort">
          <label for="sort-select">Sort by:</label>
          <select id="sort-select">
            <option value="default">Default</option>
            <option value="az">A → Z</option>
            <option value="za">Z → A</option>
            <option value="done">Done last</option>
          </select>
        </div>

        <!-- List task akan di-render oleh JavaScript -->
        <ul id="task-list" class="task-list" aria-label="Task list">
          <!-- task di-render oleh JS -->
        </ul>
      </section>

    </div><!-- end .row -->

    <!-- ==============================
         SECTION 4: Quick Links
    ================================= -->
    <section class="card links-card" aria-label="Quick Links">
      <h2 class="section-title">Quick Links</h2>

      <!-- Form tambah link -->
      <form id="link-form" class="link-form">
        <input
          id="link-name"
          type="text"
          placeholder="Link name"
          autocomplete="off"
        />
        <input
          id="link-url"
          type="url"
          placeholder="URL"
          autocomplete="off"
        />
        <button type="submit">Add Link</button>
      </form>

      <!-- List link akan di-render oleh JavaScript -->
      <div id="link-list" class="link-list" role="list" aria-label="Quick links">
        <!-- tombol link muncul di sini -->
      </div>
    </section>

  </main><!-- end .dashboard -->

  <script src="js/app.js"></script>

</body>

</html>
